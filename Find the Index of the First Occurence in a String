#include <string.h>

int strStr(char* haystack, char* needle) {
    int hLen = strlen(haystack);
    int nLen = strlen(needle);

    // If needle is empty, the result is 0 per standard convention
    if (nLen == 0) return 0;

    // We only need to loop until (hLen - nLen) 
    // because any index beyond that won't have enough characters to match the needle
    for (int i = 0; i <= hLen - nLen; i++) {
        int j = 0;
        
        // Check if characters match starting from index i
        while (j < nLen && haystack[i + j] == needle[j]) {
            j++;
        }

        // If we reached the end of the needle, we found a match
        if (j == nLen) {
            return i;
        }
    }

    // No match found
    return -1;
}
