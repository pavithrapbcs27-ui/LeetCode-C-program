#include <stdlib.h>
#include <string.h>

char* multiply(char* num1, char* num2) {
    int n1 = strlen(num1);
    int n2 = strlen(num2);
    
    // Case: either is "0"
    if (num1[0] == '0' || num2[0] == '0') return "0";

    // The max length of product is n1 + n2
    int* res = (int*)calloc(n1 + n2, sizeof(int));

    // Reverse multiply: num1[i] * num2[j]
    for (int i = n1 - 1; i >= 0; i--) {
        for (int j = n2 - 1; j >= 0; j--) {
            int mul = (num1[i] - '0') * (num2[j] - '0');
            int sum = mul + res[i + j + 1];

            res[i + j + 1] = sum % 10; // Current digit
            res[i + j] += sum / 10;    // Carry to the next left position
        }
    }

    // Convert int array to char string
    char* resultStr = (char*)malloc(sizeof(char) * (n1 + n2 + 1));
    int k = 0, i = 0;
    
    // Skip leading zero if it exists
    while (i < n1 + n2 && res[i] == 0) i++;
    
    while (i < n1 + n2) {
        resultStr[k++] = res[i++] + '0';
    }
    resultStr[k] = '\0';

    free(res);
    return resultStr;
}
