#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* countAndSay(int n) {
    if (n <= 0) return NULL;
    
    // Initial sequence
    char* current = malloc(2 * sizeof(char));
    strcpy(current, "1");
    
    for (int i = 1; i < n; i++) {
        // We allocate a larger buffer for the next iteration. 
        // In the worst case, the string roughly doubles in size.
        char* next = malloc(strlen(current) * 3 * sizeof(char));
        int nextIdx = 0;
        int len = strlen(current);
        
        for (int j = 0; j < len; j++) {
            int count = 1;
            // Count consecutive identical characters
            while (j + 1 < len && current[j] == current[j + 1]) {
                count++;
                j++;
            }
            
            // Convert count to char and append the digit
            next[nextIdx++] = count + '0';
            next[nextIdx++] = current[j];
        }
        
        next[nextIdx] = '\0'; // Null-terminate
        free(current);        // Free old buffer
        current = next;       // Move to the next string
    }
    
    return current;
}
