#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
char** summaryRanges(int* nums, int numsSize, int* returnSize) {
    char** result = (char**)malloc(numsSize * sizeof(char*));
    *returnSize = 0;
    
    if (numsSize == 0) return result;

    for (int i = 0; i < numsSize; i++) {
        int start = i;
        
        // Use long to prevent overflow during comparison
        while (i + 1 < numsSize && (long)nums[i + 1] == (long)nums[i] + 1) {
            i++;
        }
        
        // Prepare the string buffer (max size for "-2147483648->-2147483648" + null)
        char* buffer = (char*)malloc(25 * sizeof(char));
        if (start == i) {
            sprintf(buffer, "%d", nums[start]);
        } else {
            sprintf(buffer, "%d->%d", nums[start], nums[i]);
        }
        
        result[(*returnSize)++] = buffer;
    }
    
    return result;
}
